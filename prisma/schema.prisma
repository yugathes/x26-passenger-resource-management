// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum ResourceStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

enum AccessDecision {
  ALLOWED
  DENIED
}

model CrewLead {
  id         String      @id @default(uuid())
  name       String
  email      String      @unique
  role       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  passengers Passenger[]
  auditLogs  AuditLog[]
}

model Passenger {
  id         String          @id @default(uuid())
  name       String
  email      String          @unique
  phone      String?
  membership MembershipLevel @default(BRONZE)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  crewLeadId String?
  crewLead   CrewLead?       @relation(fields: [crewLeadId], references: [id])
  resources  Resource[]
  usages     ResourceUsage[]
}

model Resource {
  id          String           @id @default(uuid())
  name        String
  type        String
  status      ResourceStatus   @default(AVAILABLE)
  passengerId String?
  passenger   Passenger?       @relation(fields: [passengerId], references: [id], onDelete: SetNull)
  usages      ResourceUsage[]
  accessRules ResourceAccess[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ResourceAccess {
  id              String          @id @default(uuid())
  resourceId      String
  resource        Resource        @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  membershipLevel MembershipLevel
  decision        AccessDecision  @default(ALLOWED)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([resourceId, membershipLevel])
  @@index([membershipLevel])
}

model ResourceUsage {
  id          String    @id @default(uuid())
  resourceId  String
  resource    Resource  @relation(fields: [resourceId], references: [id])
  passengerId String
  passenger   Passenger @relation(fields: [passengerId], references: [id])
  usageStart  DateTime  @default(now())
  usageEnd    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AuditLog {
  id         String    @id @default(uuid())
  action     String
  entity     String
  entityId   String
  crewLeadId String?
  crewLead   CrewLead? @relation(fields: [crewLeadId], references: [id], onDelete: SetNull)
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([entity, entityId])
  @@index([crewLeadId])
}
