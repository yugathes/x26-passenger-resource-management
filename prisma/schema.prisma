// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Ordered lowest to highest; index order encodes the access hierarchy (Silver < Gold < Platinum)
enum MembershipLevel {
  SILVER
  GOLD
  PLATINUM
}

enum ResourceStatus {
  ACTIVE
  INACTIVE
  DECOMMISSIONED
}

enum ResourceAccessResult {
  ALLOWED
  DENIED
}

model CrewLead {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  role      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  auditLogs AuditLog[]
}

model Passenger {
  id         String          @id @default(uuid())
  name       String
  email      String          @unique
  phone      String?
  membership MembershipLevel @default(SILVER)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  usages     ResourceUsage[]
  auditLogs  AuditLog[]
}

model Resource {
  id            String          @id @default(uuid())
  name          String
  type          String
  status        ResourceStatus  @default(ACTIVE)
  minMembership MembershipLevel @default(SILVER)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  usages        ResourceUsage[]
  auditLogs     AuditLog[]
}

model ResourceUsage {
  id          String    @id @default(uuid())
  resourceId  String
  resource    Resource  @relation(fields: [resourceId], references: [id])
  passengerId String
  passenger   Passenger @relation(fields: [passengerId], references: [id])
  accessedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([resourceId])
  @@index([passengerId])
}

model AuditLog {
  id          String               @id @default(uuid())
  action      String
  result      ResourceAccessResult
  reason      String?
  passengerId String?
  passenger   Passenger?           @relation(fields: [passengerId], references: [id], onDelete: SetNull)
  resourceId  String?
  resource    Resource?            @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  crewLeadId  String?
  crewLead    CrewLead?            @relation(fields: [crewLeadId], references: [id], onDelete: SetNull)
  metadata    Json?
  createdAt   DateTime             @default(now())

  @@index([passengerId])
  @@index([resourceId])
  @@index([crewLeadId])
}
